{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(.vercel/**)",
      "Bash(printenv)",
      "Bash(printenv *)",
      "Bash(env)",
      "Bash(vercel env pull *)",
      "Bash(npx vercel env pull *)"
    ],
    "ask": ["Bash(git push *)", "Bash(vercel *)", "Bash(npx vercel *)"]
  }
}
