# Names only, never values. Nothing here is needed to run or deploy the showroom today.
# Put real values in Vercel > Project > Settings > Environment Variables, and locally in a .env file (gitignored).
# Never give a secret a VITE_ prefix: Vite copies every VITE_ variable into the public JavaScript bundle.

# --- Server (read only by api/ and server/) ---

# Where the API reads its data: "static" (default, the data/*.json files) or "http" (a backend, see below).
DATA_SOURCE=

# Base URL of the future backend, https only. Used when DATA_SOURCE=http.
BACKEND_API_URL=

# Secret key for that backend. Sent as the X-Api-Key header, never in a URL. Used when DATA_SOURCE=http.
BACKEND_API_KEY=

# --- Browser (public: built into the JavaScript bundle, so never a secret) ---

# Where the browser gets its data: "api" (default) or "static" (bundled JSON, checkout and booking switched off).
VITE_DATA_SOURCE=

# --- Planned integrations (see docs/backend-integration.md). Each hook does nothing until its variables are set. ---
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# WAMARK_API_URL=
# WAMARK_API_KEY=
# DGCC_API_URL=
# DGCC_API_KEY=
