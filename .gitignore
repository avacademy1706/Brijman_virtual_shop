# Dependencies and build output
node_modules/
dist/
.vercel/

# Secrets: never commit these
.env
.env.*
!.env.example
*.pem
*.key

# Logs and OS files
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Editor: keep the shared VS Code settings, ignore personal ones
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
