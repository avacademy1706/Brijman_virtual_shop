{
  "name": "nayan-virtual-showroom",
  "private": true,
  "version": "1.0.0",
  "description": "Walkable 3D eyewear showroom with frame details, lens options and a demo bag. Static site built with Vite and three.js.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "assets:check": "node scripts/check-assets.mjs"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "vite": "8.3.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
