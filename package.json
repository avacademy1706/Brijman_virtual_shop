{
  "name": "brijman-virtual-showroom",
  "private": true,
  "version": "1.0.0",
  "description": "Walkable 3D eyewear showroom with frame details, lens options, a server-priced bag, demo checkout and eye-test booking. Vite, three.js and a Hono API on Vercel.",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-mediapipe.mjs",
    "dev": "vite",
    "predev:phone": "node scripts/copy-mediapipe.mjs",
    "dev:phone": "vite --host",
    "prebuild": "node scripts/copy-mediapipe.mjs",
    "build": "vite build",
    "prepreview": "node scripts/copy-mediapipe.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm test && npm run build && node scripts/check-bundle.mjs",
    "smoke": "node scripts/smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "assets:check": "node scripts/check-assets.mjs",
    "bundle:check": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "hono": "4.13.11",
    "three": "0.180.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@hono/node-server": "2.1.3",
    "prettier": "3.9.9",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
