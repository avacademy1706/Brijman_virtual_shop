{
  "name": "brijman-virtual-showroom",
  "private": true,
  "version": "1.0.0",
  "description": "Walkable 3D eyewear showroom with frame details, lens options and a demo bag. Static site built with Vite and three.js.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "assets:check": "node scripts/check-assets.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "hono": "4.13.11",
    "three": "0.180.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@hono/node-server": "2.1.3",
    "prettier": "3.9.9",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
