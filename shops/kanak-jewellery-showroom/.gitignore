# Dependencies and build output
node_modules/
dist/
.vercel/

# Test output (npm run test:e2e)
test-results/
playwright-report/
blob-report/
coverage/

# Generated at build time by scripts/setup-tryon.mjs (copied from node_modules / downloaded from Google)
public/vendor/
public/models/*.task
public/models/*.part

# Secrets: never commit these
.env
.env.*
!.env.example
*.pem
*.key

# Logs and OS files
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Editor: keep the shared VS Code settings, ignore personal ones
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

# Claude Code personal settings
.claude/settings.local.json
